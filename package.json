  },
  "devDependencies": {
    "@types/node": "22.15.32",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "playwright": "1.62.1",
    "postcss": "^8.5.10",
    "supabase": "2.119.0",
